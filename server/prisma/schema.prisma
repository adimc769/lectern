datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Lecture {
  id          String              @id @default(uuid())
  title       String
  audioPath   String
  duration    Float               @default(0)
  status      String              @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  summary     String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  segments    TranscriptSegment[]
  chunks      Chunk[]
  flashcards  Flashcard[]
  keyTerms    KeyTerm[]
}

model TranscriptSegment {
  id        String   @id @default(uuid())
  lectureId String
  startTime Float
  endTime   Float
  text      String

  lecture   Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@index([lectureId])
}

model Chunk {
  id            String   @id @default(uuid())
  lectureId     String
  startTime     Float
  endTime       Float
  text          String
  embeddingJson String   // Serialized JSON array of float numbers (768-dim from nomic-embed-text)

  lecture       Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@index([lectureId])
}

model Flashcard {
  id        String   @id @default(uuid())
  lectureId String
  front     String
  back      String

  lecture   Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@index([lectureId])
}

model KeyTerm {
  id         String   @id @default(uuid())
  lectureId  String
  term       String
  definition String

  lecture    Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@index([lectureId])
}

model Document {
  id        String   @id @default(uuid())
  title     String
  docType   String   // PDF, DOCX, TXT
  status    String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  filePath  String
  pageCount Int      @default(0)
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages     DocumentPage[]
  chunks    DocumentChunk[]
  exams     Exam[]
}

model DocumentPage {
  id          String   @id @default(uuid())
  documentId  String
  pageNo      Int
  text        String
  sectionsJson String  @default("[]") // Serialized JSON array of detected section headings

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model DocumentChunk {
  id            String   @id @default(uuid())
  documentId    String
  pageNo        Int      @default(1)
  section       String?
  text          String
  embeddingJson String   // Serialized JSON array of float numbers (768-dim from nomic-embed-text)

  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Exam {
  id          String   @id @default(uuid())
  documentId  String
  status      String   @default("PROCESSING") // PROCESSING, COMPLETED, FAILED
  total       Int      @default(0)
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  questions   ExamQuestion[]

  @@index([documentId])
}

model ExamQuestion {
  id             String   @id @default(uuid())
  examId         String
  qtype          String   // mcq, tf, identification
  question       String
  choicesJson    String   @default("[]") // Serialized JSON array of 4 choice strings (mcq only)
  answerIndex    Int?
  answer         String?
  acceptableJson String   @default("[]") // Serialized JSON array of acceptable answers (identification)
  explanation    String   @default("")
  pageNo         Int?
  section        String?

  exam           Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
}
